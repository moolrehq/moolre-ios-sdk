// Copy this file to Credentials.xcconfig in the same folder. Credentials.xcconfig is
// git-ignored and must never be committed.
//
// Replace the API user and account placeholders with values from one environment.
// Keep SANDBOX for testing:
MOOLRE_ENVIRONMENT = SANDBOX
MOOLRE_API_USER = replace-with-your-moolre-username
// Optional in SANDBOX. Leave blank unless Moolre provided a sandbox public key.
MOOLRE_PUBLIC_KEY =
MOOLRE_ACCOUNT_NUMBER = replace-with-your-sandbox-account-number
//
// Only needed to run on a real iPhone. A free Apple ID "Personal Team" works.
// The bundle ID must be unique to you, e.g. com.yourname.moolreexample.
// DEVELOPMENT_TEAM = YOURTEAMID
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.moolreexample
//
// For production, use matching live credentials; the public key is required:
// MOOLRE_ENVIRONMENT = LIVE
// MOOLRE_API_USER = replace-with-your-moolre-username
// MOOLRE_PUBLIC_KEY = replace-with-your-live-public-key
// MOOLRE_ACCOUNT_NUMBER = replace-with-your-live-account-number
